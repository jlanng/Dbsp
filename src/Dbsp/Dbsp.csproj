<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Dbsp</PackageId>
    <Description>DBSP-style incremental stream processing for .NET: collections are Z-sets, streams carry deltas, and every operator — joins and aggregations included — processes only the changes, never the full state.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The exchange wire codec is an internal detail with a public consequence: a value that
         does not round-trip is silent cross-process corruption. The tests reach it directly. -->
    <InternalsVisibleTo Include="Dbsp.Tests" />
    <InternalsVisibleTo Include="Dbsp.Torture" />
    <!-- The Kafka logs write the default serializer's JSON straight to UTF-8 (its options)
         and ask whether a table's key type serializes equal values alike. -->
    <InternalsVisibleTo Include="Dbsp.Kafka" />
    <!-- LogSerializationBenchmarks compares the logs' JSON with the dense exchange codec. -->
    <InternalsVisibleTo Include="Dbsp.Benchmarks" />
    <!-- The proving format level (Storage/PersistedFormat.cs): a level no build writes,
         which the rolling-upgrade tests run a pair of nodes across. -->
    <InternalsVisibleTo Include="Dbsp.Service" />
    <InternalsVisibleTo Include="Dbsp.Kafka.Tests" />
    <InternalsVisibleTo Include="Dbsp.Service.Tests" />
  </ItemGroup>

</Project>
