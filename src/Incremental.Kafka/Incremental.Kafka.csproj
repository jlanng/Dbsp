<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Incremental.Kafka</PackageId>
    <Description>Kafka-backed durability for Incremental: the state changelog and shared-table logs on compacted topics, written through one transactional producer per process (group commit, transactional.id fencing) and followed by a warm standby.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Incremental\Incremental.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Incremental.Kafka.Tests" />
    <!-- The log's fault-injection seams (KafkaLog.WhileAcquiring): a takeover that is
         lost, provoked under a whole service node. -->
    <InternalsVisibleTo Include="Incremental.Service.Tests" />
  </ItemGroup>

</Project>
