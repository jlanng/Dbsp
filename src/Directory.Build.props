<Project>

  <!-- src/ holds only the shipped library projects; everything here is packaging-wide. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>0.1.0</Version>
    <Authors>James Lanng</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jlanng/Incremental</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jlanng/Incremental</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dbsp;incremental;streaming;dataflow</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API is documented; CS1591 would otherwise demand XML docs on every member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
