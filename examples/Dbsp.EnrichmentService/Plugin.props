<Project>

  <!--
    What makes a project a plugin package rather than an application. A plugin compiles
    against Dbsp (the core) and Dbsp.Service.Abstractions (the definition
    interfaces, PipelineBuilder, table definitions) and nothing else of the service: no
    hosting, no Kafka. The host provides both at runtime, so the plugin copies neither: its
    output directory holds the plugin, its .deps.json and its private dependencies — and
    that directory (or a zip of it) is what the service imports.

    A NuGet package the plugin references is a private dependency: CopyLocalLockFileAssemblies
    copies its assemblies beside the plugin. What the two references bring with them must
    not be copied — the host has it — hence ExcludeAssets="runtime;native".
    PluginBoundaryTests (tests/Dbsp.Service.Tests) fails if a plugin references, or
    the abstractions' surface reaches, the service's hosting or Kafka assemblies.

    Outside this repository the two ProjectReferences are PackageReferences with
    PrivateAssets="all" ExcludeAssets="runtime;native".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Dbsp.Service.Abstractions\Dbsp.Service.Abstractions.csproj" Private="false" ExcludeAssets="runtime;native" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Dbsp\Dbsp.csproj" Private="false" ExcludeAssets="runtime;native" />
  </ItemGroup>

</Project>
