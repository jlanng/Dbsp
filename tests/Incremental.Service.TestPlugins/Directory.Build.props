<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- Plugin and contract assemblies the service tests load at runtime from these projects'
       output directories. They compile against the core and Incremental.Service.Abstractions
       only, as a plugin outside this repository does (PluginBoundaryTests holds them to it).
       The host provides Incremental*, so nothing of it is copied here: an output directory
       holds the plugin, its .deps.json and its private dependencies, which is what a plugin
       package is. A package the plugin references is a private dependency and is copied
       (CopyLocalLockFileAssemblies); what the two references bring is not. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Incremental.Service.Abstractions\Incremental.Service.Abstractions.csproj" Private="false" ExcludeAssets="runtime;native" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Incremental\Incremental.csproj" Private="false" ExcludeAssets="runtime;native" />
  </ItemGroup>

</Project>
