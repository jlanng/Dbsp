<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A service node with the admin UI mounted, on the in-memory backend, with tables,
       pipelines and a generator: what the admin API's tests run against, and what a person
       runs to look at the UI (dotnet run, project tests/Dbsp.Service.AdminHost). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dbsp.Service\Dbsp.Service.csproj" />
    <ProjectReference Include="..\..\src\Dbsp.Service.Admin\Dbsp.Service.Admin.csproj" />
    <ProjectReference Include="..\Dbsp.Service.TestPlugins\Acme.Contracts\Acme.Contracts.csproj" />
    <!-- Built, never referenced: imported from its output directory as a stored plugin. -->
    <ProjectReference Include="..\Dbsp.Service.TestPlugins\Acme.Pipelines\Acme.Pipelines.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../tests/Shared/CommandLine.cs" Link="CommandLine.cs" />
  </ItemGroup>

</Project>
