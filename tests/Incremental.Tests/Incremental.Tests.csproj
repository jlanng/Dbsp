<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="CsCheck" Version="4.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Incremental\Incremental.csproj" />
    <ProjectReference Include="..\..\src\Incremental.Hosting\Incremental.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Incremental.Storage.Redis\Incremental.Storage.Redis.csproj" />
    <!-- Build-order only: MultiProcessClusterTests launches the host as child processes. -->
    <ProjectReference Include="..\Incremental.ClusterHost\Incremental.ClusterHost.csproj" ReferenceOutputAssembly="false" />
    <!-- Source-shared with the host so the scenario and reference run can never drift. -->
    <Compile Include="..\Incremental.ClusterHost\ClusterScenario.cs" Link="ClusterScenario.cs" />
  </ItemGroup>

</Project>